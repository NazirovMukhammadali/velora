NODE_ENV=
PORT=3003
MONGO_DEV=
MONGO_PROD=
SECRET_TOKEN=
CORS_ORIGINS=

# Where uploaded images are stored and served from (/uploads). Default: ./uploads (relative to the app's cwd).
# In production point this at a persistent volume (e.g. /data/uploads) — container disks are wiped on redeploy.
UPLOADS_DIR=

# AI assistant (Google AI Studio key: https://aistudio.google.com/apikey). Empty key → built-in FAQ answers only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
